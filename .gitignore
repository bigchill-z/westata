# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/
.ipynb_checkpoints/
*.log
.DS_Store

# Downloaded Stata example datasets -- not redistributed with the repository.
tests/data/*.dta
tests/data/*.csv
tests/data/raw/

# EXCEPTION: auto.dta (6.4 KB) is needed by 12 test modules. Without it a fresh clone fails 34 tests with
# FileNotFoundError, which is exactly what CI does on checkout. The negation must come AFTER the pattern it
# overrides -- placed before, it has no effect.
!tests/data/auto.dta

# Downloaded Stata manuals (copyright StataCorp; used only for cross-checking, never committed).
docs/reference/

# Throwaway probe scripts from investigation rounds.
probe*.py
scratch_*
tmp_*

# Commit-message scratch files.
commit_msg.txt
p11_msg.txt

# Agent-team runtime state.
.agent-teams/

# retest intermediate output: regenerated on every run, different bytes each time.
retest/domains/*/_tmp/
